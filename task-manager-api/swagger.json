{
  "swagger": "2.0",
  "info": {
    "title": "Task Manager API",
    "description": "API for managing tasks and users",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "",
  "schemes": ["http"],
  "paths": {
    "/tasks": {
      "get": {
        "description": "Get all tasks",
        "responses": {
          "200": { "description": "OK" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "post": {
        "description": "Create a new task",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "title": { "example": "Finish homework" },
                "description": { "example": "Complete lesson 5 assignment" },
                "status": { "example": "in progress" },
                "priority": { "example": "high" },
                "dueDate": { "example": "2026-04-10" },
                "userId": { "example": "123" }
              }
            }
          }
        ],
        "responses": {
          "201": { "description": "Created" },
          "400": { "description": "Bad Request" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/tasks/{id}": {
      "get": {
        "description": "Get task by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "put": {
        "description": "Update a task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "title": { "example": "Updated task" },
                "description": { "example": "Updated description" },
                "status": { "example": "completed" },
                "priority": { "example": "high" },
                "dueDate": { "example": "2026-04-10" },
                "userId": { "example": "123" }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "Task updated successfully" },
          "404": { "description": "Task not found" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "delete": {
        "description": "Delete a task",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not Found" },
          "500": { "description": "Internal Server Error" }
        }
      }
    },
    "/users": {
      "get": {
        "description": "Get all users",
        "responses": {
          "200": { "description": "OK" },
          "500": { "description": "Internal Server Error" }
        }
      },
      "post": {
        "description": "Create a new user",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": { "example": "Rodrigo Alexis" },
                "email": { "example": "rodrigo@example.com" },
                "role": { "example": "student" },
                "phone": { "example": "503-1234-5678" },
                "address": { "example": "San Salvador, El Salvador" },
                "department": { "example": "Computer Science" },
                "status": { "example": "active" }
              }
            }
          }
        ],
        "responses": {
          "201": { "description": "Created" },
          "400": { "description": "Bad Request" },
          "500": { "description": "Internal Server Error" }
        }
      }
    }
  }
}